
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Rules for the 'artisans' collection
    match /artisans/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /artisans/{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /users/{document=**} {
        allow read, write: if isSignedIn();
    }

    // Rules for the 'wallets' collection
    match /wallets/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      
      // Rules for transactions subcollection
      match /transactions/{transactionId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      
      // Rules for vaults subcollection
      match /vaults/{vaultId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Rules for the 'sellers' collection
    match /sellers/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
    }

    // Rules for the 'reports' collection
    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Rules for comments subcollection
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      }
    }

    // Rules for the 'alerts' collection
    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow write: if false; // Only system/admin can create alerts
    }
    
    // Rules for other collections
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }
    
    match /areas/{areaId} {
        allow read: if true;
        allow write: if false; // Managed by backend
    }

    match /transactions/{transactionId} {
        allow read, write: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Rules for the 'pending_products' collection
    match /pending_products/{productId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Rules for the 'approved_products' collection
    match /approved_products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Rules for the 'events' collection
    match /events/{eventId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Rules for the 'businesses' collection
    match /businesses/{businessId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Rules for the 'kyc' collection — each user can only access their own KYC document
    match /kyc/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // Rules for Power Grid Vended Tokens
    match /power_tokens/{tokenId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'guest-session');
      allow create: if true; // Allows instant vending with valid token receipt
      allow update, delete: if false; // Tokens are immutable receipts
    }

    // Rules for Ibom Air Flight Bookings & E-Tickets
    match /flight_bookings/{bookingId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'guest-session');
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Rules for FloodSense AKS Telemetry & Citizen Reports
    match /flood_sensors/{sensorId} {
      allow read: if true; // Public state drainage telemetry
      allow write: if false; // Only backend ingestion nodes can write
    }

    match /flood_reports/{reportId} {
      allow read: if true; // Public emergency radar for all citizens
      allow create: if true; // Allows rapid citizen flood hazard reporting
      allow update: if true; // Allows community upvoting
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Rules for Civic & AKSWMA Drainage Tickets
    match /civic_tickets/{ticketId} {
      allow read: if isSignedIn();
      allow create: if true;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Rules for Nearby AirSend Mesh Presence & Transfers
    match /airsend_presence/{userId} {
      allow read: if true; // Active proximity discovery
      allow write, delete: if isSignedIn() && isOwner(userId);
    }

    match /airsend_transfers/{transferId} {
      allow read: if isSignedIn() && (
        resource.data.recipientUid == request.auth.uid || 
        resource.data.senderUid == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow delete: if false;
    }

    // Rules for Live Mobility & Transit Tracking
    match /live_tracking/{orderId} {
      allow read: if true; // Real-time transit visualization
      allow write: if isSignedIn(); // Verified drivers can publish location
    }

    // Legacy AirSend routes
    match /air_receivers/{document=**} {
      allow read, write: if isSignedIn();
    }
    match /air_requesters/{document=**} {
      allow read, write: if isSignedIn();
    }
    match /air_transfers/{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
